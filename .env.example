# Signal CLI Allowlist Proxy
# ============================================================
#
# NOTE: the containers do NOT read any variables from this file.
# Configuration is done two ways:
#
#   1. Allowlist  -> cp allowlist/allowlist.example allowlist/allowlist
#                    then edit (one E.164 number per line, mounted read-only;
#                    the real file is gitignored)
#   2. Account    -> linked at runtime via startLink/finishLink
#                    (stored in the `signal-session` Docker volume)
#
# This file is kept only as a record of which account is in use.
#
# Architecture:
#   Hermes Agent  -->  Allowlist Proxy (9921, published)
#                     -->  signal-cli (9920, internal only)
#
# ============================================================

# Informational only — the linked Signal account (E.164 format)
SIGNAL_ACCOUNT=+15551234567
