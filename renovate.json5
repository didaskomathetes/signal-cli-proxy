{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  automerge: false,
  platformAutomerge: false,
  automergeType: 'none',
  'docker-compose': {
    enabled: false,
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Dockerfile$/',
      ],
      matchStrings: [
        'ARG SIGNAL_CLI_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)',
      ],
      depNameTemplate: 'AsamK/signal-cli',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/renovate-entrypoint\\.sh$/',
      ],
      matchStrings: [
        'UV_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)',
      ],
      depNameTemplate: 'astral-sh/uv',
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  prConcurrentLimit: 2,
  packageRules: [
    {
      matchDepNames: [
        'AsamK/signal-cli',
      ],
      groupName: 'signal-cli',
      postUpgradeTasks: {
        commands: [
          'node scripts/update-signal-cli-checksum.mjs',
        ],
        fileFilters: [
          'Dockerfile',
        ],
        executionMode: 'branch',
      },
    },
    {
      matchDepNames: [
        'astral-sh/uv',
      ],
      postUpgradeTasks: {
        commands: [
          'node scripts/update-uv-checksum.mjs',
        ],
        fileFilters: [
          '.github/renovate-entrypoint.sh',
        ],
        // 'update' (not 'branch'): in a grouped branch the branch-level
        // postUpgradeTasks are taken from the FIRST upgrade (sorted by
        // depName), so 'branch' mode silently skips this task whenever a
        // dep like astral-sh/setup-uv sorts earlier in the group (this
        // happened in PR #13, leaving stale checksums behind). 'update'
        // mode runs the task for every upgrade that defines it; the script
        // is idempotent, so the duplicate run for the uses-with entry is a
        // no-op.
        executionMode: 'update',
      },
    },
    {
      matchPackageNames: [
        'python',
      ],
      allowedVersions: '/^3\\.12\\./',
    },
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'minor and patch updates',
      groupSlug: 'minor-patch',
      matchDepNames: [
        '!AsamK/signal-cli',
      ],
    },
  ],
}
